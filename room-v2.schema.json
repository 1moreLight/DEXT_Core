{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dext.app/schema/room-v2.json",
  "title": "Dext Room v2 source contract",
  "description": "Strict source form of Room v2. Widget execution and grants are not part of this contract package.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "startDesk", "switches", "desks"],
  "properties": {
    "version": { "const": 2 },
    "startDesk": { "type": "integer", "minimum": 0 },
    "start": { "$ref": "https://dext.app/schema/room-v1.json#/$defs/startContent" },
    "idle": { "$ref": "https://dext.app/schema/room-v1.json#/$defs/idleContent" },
    "switch": { "$ref": "https://dext.app/schema/room-v1.json#/$defs/switchValue" },
    "switches": {
      "type": "object",
      "propertyNames": { "pattern": "^(0|[1-9][0-9]*)>(0|[1-9][0-9]*)$" },
      "additionalProperties": { "$ref": "https://dext.app/schema/room-v1.json#/$defs/switchValue" },
      "default": {}
    },
    "dock": { "$ref": "https://dext.app/schema/room-v1.json#/$defs/dock" },
    "desks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/desk" } }
  },
  "$defs": {
    "widgetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "widgetPath": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1024,
      "pattern": "^widgets/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[. ](?:/|$))(?!.*[\\\\:*?\"<>|])[^\\u0000-\\u001F/]+(?:/[^\\u0000-\\u001F/]+)*$"
    },
    "widgetResource": {
      "allOf": [
        { "$ref": "#/$defs/widgetPath" },
        { "pattern": "\\.(?:html?|css|m?js|json|png|jpe?g|webp|gif|svg|woff2?|ttf|otf)$" }
      ]
    },
    "permission": {
      "enum": [
        "time.read", "locale.read", "viewport.read", "desk.read", "playback.read",
        "audio.spectrum", "hardware.cpu.read", "hardware.gpu.read", "hardware.memory.read",
        "now-playing.read", "now-playing.artwork.read", "hardware.network.read", "network.proxy",
        "storage.kv", "navigation.go", "notification.show", "action.invoke"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 1856 },
        "y": { "type": "integer", "minimum": 0, "maximum": 1016 },
        "width": { "type": "integer", "minimum": 64, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 64, "maximum": 1080 },
        "z": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "src", "resources", "placement", "config", "permissions"],
      "properties": {
        "id": { "$ref": "#/$defs/widgetId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "src": { "allOf": [{ "$ref": "#/$defs/widgetPath" }, { "pattern": "\\.html?$" }] },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/widgetResource" }
        },
        "placement": { "$ref": "#/$defs/placement" },
        "config": { "type": "object" },
        "permissions": {
          "type": "array",
          "maxItems": 17,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" }
        }
      }
    },
    "desk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "background", "iconSize", "icons", "widgets"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "background": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "https://dext.app/schema/room-v1.json#/$defs/backgroundContent" }
          ]
        },
        "iconSize": { "enum": ["large", "medium", "small"] },
        "icons": {
          "type": "array",
          "items": { "$ref": "https://dext.app/schema/room-v1.json#/$defs/desktopIcon" }
        },
        "dock": { "$ref": "https://dext.app/schema/room-v1.json#/$defs/dock" },
        "widgets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/widget" } }
      }
    }
  }
}
