{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dext.app/schema/room-v2.json",
  "title": "Dext Room v2 source contract",
  "description": "Strict source/export form of the only supported Dext Room contract. Runtime-only __source is intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "startDesk",
    "switches",
    "desks"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "startDesk": {
      "type": "integer",
      "minimum": 0
    },
    "start": {
      "$ref": "#/$defs/startContent"
    },
    "idle": {
      "$ref": "#/$defs/idleContent"
    },
    "switch": {
      "$ref": "#/$defs/switchValue"
    },
    "switches": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)>(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/switchValue"
      },
      "default": {}
    },
    "dock": {
      "$ref": "#/$defs/dock"
    },
    "desks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/desk"
      }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^(?!.*//)(?!.*[. ](?:/|$))(?!.*[\\\\:*?\"<>|])[^\\u0000-\\u001F/]+(?:/[^\\u0000-\\u001F/]+)*$"
    },
    "backgroundPath": {
      "allOf": [
        {
          "$ref": "#/$defs/safeRelativePath"
        },
        {
          "pattern": "^background/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$)).+"
        }
      ]
    },
    "startPath": {
      "allOf": [
        {
          "$ref": "#/$defs/safeRelativePath"
        },
        {
          "pattern": "^start/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$)).+"
        }
      ]
    },
    "switchPath": {
      "allOf": [
        {
          "$ref": "#/$defs/safeRelativePath"
        },
        {
          "pattern": "^switch/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$)).+"
        }
      ]
    },
    "idlePath": {
      "allOf": [
        {
          "$ref": "#/$defs/safeRelativePath"
        },
        {
          "pattern": "^idle/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$)).+"
        }
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "name",
        "type",
        "src"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": [
            "image",
            "video",
            "html"
          ]
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "src": {
                "pattern": "\\.(?:png|jpe?g|webp|bmp|gif|svg)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "src": {
                "pattern": "\\.(?:mp4|webm)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "html"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "src": {
                "pattern": "\\.html?$"
              }
            }
          }
        }
      ]
    },
    "backgroundContent": {
      "allOf": [
        {
          "$ref": "#/$defs/content"
        },
        {
          "properties": {
            "src": {
              "$ref": "#/$defs/backgroundPath"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "startContent": {
      "allOf": [
        {
          "$ref": "#/$defs/content"
        },
        {
          "properties": {
            "src": {
              "$ref": "#/$defs/startPath"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "switchContent": {
      "allOf": [
        {
          "$ref": "#/$defs/content"
        },
        {
          "properties": {
            "src": {
              "$ref": "#/$defs/switchPath"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "idleContent": {
      "allOf": [
        {
          "$ref": "#/$defs/content"
        },
        {
          "properties": {
            "src": {
              "$ref": "#/$defs/idlePath"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "switchPreset": {
      "enum": [
        "slide",
        "fade",
        "zoom",
        "none"
      ]
    },
    "switchValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/switchPreset"
        },
        {
          "$ref": "#/$defs/switchContent"
        }
      ]
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "args",
        "workdir"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "args": {
          "type": "string",
          "maxLength": 4096
        },
        "workdir": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "iconFields": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "icon_png": {
          "type": "string"
        },
        "glyph": {
          "type": "string",
          "maxLength": 32
        },
        "color": {
          "type": "string",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "maxLength": 512
        },
        "launch": {
          "$ref": "#/$defs/launch"
        }
      }
    },
    "desktopIcon": {
      "allOf": [
        {
          "$ref": "#/$defs/iconFields"
        },
        {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dockIcon": {
      "allOf": [
        {
          "$ref": "#/$defs/iconFields"
        }
      ],
      "unevaluatedProperties": false
    },
    "dockStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg": {
          "type": "string",
          "maxLength": 256
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "radius": {
          "type": "string",
          "maxLength": 64
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "pad": {
          "type": "string",
          "maxLength": 64
        },
        "icon": {
          "type": "number",
          "minimum": 16,
          "maximum": 256
        }
      }
    },
    "dock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "position": {
          "enum": [
            "bottom",
            "top",
            "left",
            "right"
          ]
        },
        "autoHide": {
          "type": "boolean"
        },
        "indicator": {
          "enum": [
            "text",
            "dots"
          ]
        },
        "style": {
          "$ref": "#/$defs/dockStyle"
        },
        "icons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dockIcon"
          }
        }
      }
    },
    "desk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "background",
        "iconSize",
        "icons",
        "widgets"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "background": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/backgroundContent"
            }
          ]
        },
        "iconSize": {
          "enum": [
            "large",
            "medium",
            "small"
          ]
        },
        "icons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/desktopIcon"
          }
        },
        "dock": {
          "$ref": "#/$defs/dock"
        },
        "widgets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/widget"
          }
        }
      }
    },
    "widgetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "widgetPath": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1024,
      "pattern": "^widgets/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[. ](?:/|$))(?!.*[\\\\:*?\"<>|])[^\\u0000-\\u001F/]+(?:/[^\\u0000-\\u001F/]+)*$"
    },
    "widgetResource": {
      "allOf": [
        {
          "$ref": "#/$defs/widgetPath"
        },
        {
          "pattern": "\\.(?:html?|css|m?js|json|png|jpe?g|webp|gif|svg|woff2?|ttf|otf)$"
        }
      ]
    },
    "permission": {
      "enum": [
        "time.read",
        "locale.read",
        "viewport.read",
        "desk.read",
        "playback.read",
        "audio.spectrum",
        "hardware.cpu.read",
        "hardware.gpu.read",
        "hardware.memory.read",
        "now-playing.read",
        "now-playing.artwork.read",
        "hardware.network.read",
        "network.proxy",
        "storage.kv",
        "navigation.go",
        "notification.show",
        "action.invoke"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "z"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1856
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1016
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 1080
        },
        "z": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "src",
        "resources",
        "placement",
        "config",
        "permissions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/widgetId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "src": {
          "allOf": [
            {
              "$ref": "#/$defs/widgetPath"
            },
            {
              "pattern": "\\.html?$"
            }
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/widgetResource"
          }
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "config": {
          "type": "object"
        },
        "permissions": {
          "type": "array",
          "maxItems": 17,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        }
      }
    }
  }
}
