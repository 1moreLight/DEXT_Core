{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dext Configurator",
  "version": "0.1.0",
  "identifier": "com.jan.tauri-ui",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1620 --strictPort",
    "devUrl": "http://localhost:1620",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dext 配置器",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
